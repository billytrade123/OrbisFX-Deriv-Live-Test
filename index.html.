
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OrbisFX Live Tick Test</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080d18;color:#eef4ff;font-family:Arial,sans-serif;padding:20px}
.container{max-width:600px;margin:auto}
.brand{color:#38bdf8;font-size:14px;letter-spacing:3px;font-weight:bold}
h1{font-size:28px;margin-bottom:6px}
.sub{color:#9caec7;font-size:14px}
.card{background:#111a2b;border:1px solid #24334b;border-radius:14px;padding:18px;margin-top:16px}
.label{color:#9caec7;font-size:13px}
.value{font-size:25px;font-weight:bold;margin-top:8px;overflow-wrap:anywhere}
.status{color:#fbbf24}
button,select{width:100%;padding:13px;border-radius:9px;border:1px solid #334766;background:#17243a;color:white;font-size:15px;margin-top:10px}
button{background:#0284c7;border:0;font-weight:bold}
button:disabled{opacity:.6}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.digit{font-size:48px;color:#38bdf8}
#ticks{padding-left:20px;color:#c7d5e9;line-height:1.8;overflow-wrap:anywhere}
.note{font-size:12px;color:#8497b4;line-height:1.6;margin-top:18px}
</style>
</head>
<body>
<div class="container">
<div class="brand">ORBISFX</div>
<h1>Deriv Live Tick Test</h1>
<p class="sub">Live market data connection checker</p>

<div class="card">
<div class="label">Market</div>
<select id="market">
<option value="1HZ100V">Volatility 100 (1s) Index</option>
<option value="1HZ50V">Volatility 50 (1s) Index</option>
<option value="1HZ25V">Volatility 25 (1s) Index</option>
<option value="1HZ75V">Volatility 75 (1s) Index</option>
<option value="R_100">Volatility 100 Index</option>
<option value="R_50">Volatility 50 Index</option>
<option value="R_25">Volatility 25 Index</option>
<option value="R_75">Volatility 75 Index</option>
</select>
<button id="connect">Connect to Deriv</button>
<div class="label" style="margin-top:14px">Connection status</div>
<div class="value status" id="status">Not connected</div>
</div>

<div class="grid">
<div class="card">
<div class="label">Live price</div>
<div class="value" id="price">—</div>
</div>
<div class="card">
<div class="label">Last digit</div>
<div class="digit" id="digit">—</div>
</div>
</div>

<div class="card">
<div class="label">Ticks received</div>
<div class="value" id="count">0</div>
<div class="label" style="margin-top:18px">Recent ticks</div>
<ol id="ticks"><li>Waiting for connection</li></ol>
</div>

<p class="note">This page reads public market tick data only. It does not place trades or guarantee predictions. Internet access is required.</p>
</div>

<script>
const statusEl=document.getElementById("status");
const priceEl=document.getElementById("price");
const digitEl=document.getElementById("digit");
const countEl=document.getElementById("count");
const ticksEl=document.getElementById("ticks");
const connectBtn=document.getElementById("connect");
const marketEl=document.getElementById("market");
let socket=null, count=0, recent=[], reconnectTimer=null;

function setStatus(text,color="#fbbf24"){
  statusEl.textContent=text;
  statusEl.style.color=color;
}
function disconnect(){
  if(reconnectTimer){clearTimeout(reconnectTimer);reconnectTimer=null;}
  if(socket){
    socket.onclose=null;
    socket.onerror=null;
    socket.onmessage=null;
    socket.close();
    socket=null;
  }
}
function connect(){
  disconnect();
  count=0;recent=[];
  countEl.textContent="0";
  priceEl.textContent="—";
  digitEl.textContent="—";
  ticksEl.innerHTML="<li>Connecting…</li>";
  setStatus("Connecting…");
  connectBtn.disabled=true;
  const symbol=marketEl.value;
  try{
    socket=new WebSocket("wss://ws.derivws.com/websockets/v3?app_id=1089");
    socket.onopen=()=>{
      setStatus("Connected — subscribing…","#38bdf8");
      socket.send(JSON.stringify({ticks:symbol,subscribe:1}));
    };
    socket.onmessage=(event)=>{
      let data;
      try{data=JSON.parse(event.data)}catch(e){return}
      if(data.error){
        setStatus("Error: "+data.error.message,"#fb7185");
        connectBtn.disabled=false;
        return;
      }
      if(data.msg_type==="tick" && data.tick){
        const p=String(data.tick.quote);
        const digits=p.replace(/\D/g,"");
        const last=digits.length?digits.slice(-1):"—";
        priceEl.textContent=p;
        digitEl.textContent=last;
        count++;
        countEl.textContent=String(count);
        recent.unshift(p+"  |  last digit: "+last);
        recent=recent.slice(0,8);
        ticksEl.innerHTML=recent.map(x=>"<li>"+x+"</li>").join("");
        setStatus("Live data received","#4ade80");
      }
    };
    socket.onerror=()=>{
      setStatus("Connection error — check internet or try again","#fb7185");
      connectBtn.disabled=false;
    };
    socket.onclose=()=>{
      if(statusEl.textContent.startsWith("Live")||statusEl.textContent.startsWith("Connected")){
        setStatus("Connection closed — tap Connect to retry","#fbbf24");
      }
      connectBtn.disabled=false;
    };
    setTimeout(()=>{
      if(socket && socket.readyState!==WebSocket.OPEN){
        setStatus("Still connecting — check internet and retry","#fbbf24");
        connectBtn.disabled=false;
      }
    },10000);
  }catch(e){
    setStatus("Could not start connection","#fb7185");
    connectBtn.disabled=false;
  }
}
connectBtn.addEventListener("click",connect);
marketEl.addEventListener("change",()=>{
  if(socket && socket.readyState===WebSocket.OPEN) connect();
});
</script>
</body>
</html>
